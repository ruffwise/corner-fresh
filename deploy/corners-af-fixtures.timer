[Unit]
Description=corners collector timer: api-football season fixtures every 6 h

[Timer]
OnCalendar=*-*-* 00/6:15:00
AccuracySec=1s
RandomizedDelaySec=0
# A run missed while the machine was down must show up as a missed slot,
# not as a late catch-up run that looks on time.
Persistent=false
Unit=corners@af-fixtures.service

[Install]
WantedBy=timers.target
