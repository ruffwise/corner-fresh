[Unit]
Description=corners collector timer: plan the next 48 h of expected slots

[Timer]
OnCalendar=*-*-* *:00:00
AccuracySec=1s
RandomizedDelaySec=0
# A run missed while the machine was down must show up as a missed slot,
# not as a late catch-up run that looks on time.
Persistent=false
Unit=corners@plan.service

[Install]
WantedBy=timers.target
