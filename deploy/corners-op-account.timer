[Unit]
Description=corners collector timer: OddsPapi quota reading daily (free)

[Timer]
OnCalendar=*-*-* 00:50:00
AccuracySec=1s
RandomizedDelaySec=0
# A run missed while the machine was down must show up as a missed slot,
# not as a late catch-up run that looks on time.
Persistent=false
Unit=corners@op-account.service

[Install]
WantedBy=timers.target
