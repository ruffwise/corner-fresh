[Unit]
Description=corners collector timer: api-football results and corner statistics hourly

[Timer]
OnCalendar=*-*-* *:35:00
AccuracySec=1s
RandomizedDelaySec=0
# A run missed while the machine was down must show up as a missed slot,
# not as a late catch-up run that looks on time.
Persistent=false
Unit=corners@af-results.service

[Install]
WantedBy=timers.target
