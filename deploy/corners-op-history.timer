[Unit]
Description=corners collector timer: OddsPapi Pinnacle history for finished fixtures (free)

[Timer]
OnCalendar=*-*-* *:45:00
AccuracySec=1s
RandomizedDelaySec=0
# A run missed while the machine was down must show up as a missed slot,
# not as a late catch-up run that looks on time.
Persistent=false
Unit=corners@op-history.service

[Install]
WantedBy=timers.target
