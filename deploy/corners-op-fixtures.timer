[Unit]
Description=corners collector timer: OddsPapi fixture listing, only when a refresh is due (billable)

[Timer]
OnCalendar=*-*-* 00:55:00
AccuracySec=1s
RandomizedDelaySec=0
# A run missed while the machine was down must show up as a missed slot,
# not as a late catch-up run that looks on time.
Persistent=false
Unit=corners@op-fixtures.service

[Install]
WantedBy=timers.target
